<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.logiopt</groupId>
        <artifactId>logiopt-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!-- Shared by every front end: model, planning engine and strategies, services, DAOs,
         migrations (db/migration) and the report service. No Servlet or UI dependency. -->
    <artifactId>logiopt-core</artifactId>
    <packaging>jar</packaging>
    <name>LogiOpt core</name>

    <dependencies>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- DemoScriptIntegrationTest reads docs/demo from the repository root. -->
                        <logiopt.repoRoot>${project.basedir}/..</logiopt.repoRoot>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Publishes TestData and TestDatabase (and the V999 test script) for logiopt-web's tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
