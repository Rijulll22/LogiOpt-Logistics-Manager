<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>LogiOpt</display-name>

    <!-- Filters run in the order of the filter-mapping elements below. They are declared only here
         (no @WebFilter), so the order is explicit:
         1. SecurityHeadersFilter: X-Frame-Options, nosniff, Referrer-Policy, Content-Security-Policy and
            Cache-Control: no-store on every response, including the 503 and error responses below.
         2. SchemaGateFilter: generic 503 page while the schema is behind this build (command only in the log).
         3. AuthFilter: sign-in required except /login and /register; /admin only for the admin (404 otherwise).
         4. CsrfFilter: per-session token, required on every state-changing request (403 otherwise). -->
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>com.logiopt.web.SecurityHeadersFilter</filter-class>
    </filter>
    <filter>
        <filter-name>SchemaGateFilter</filter-name>
        <filter-class>com.logiopt.web.SchemaGateFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.logiopt.web.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.logiopt.web.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>SchemaGateFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Server-side sessions: 30 minutes idle timeout; the JSESSIONID cookie is HttpOnly and
         SameSite=Lax and is the only tracking mode (no ;jsessionid in URLs). Tomcat adds Secure
         automatically when the request arrives over HTTPS. -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <attribute>
                <attribute-name>SameSite</attribute-name>
                <attribute-value>Lax</attribute-value>
            </attribute>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <scripting-invalid>true</scripting-invalid>
        </jsp-property-group>
    </jsp-config>

    <!-- Read form fields as UTF-8 even when a filter reads them before a Servlet does. -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!-- Friendly pages (no stack traces) for errors the container raises itself, for example a
         malformed request or a method a Servlet does not support. Errors the application reports
         are rendered by WebSupport.error with the same JSP. -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>401</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>429</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>503</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
</web-app>
